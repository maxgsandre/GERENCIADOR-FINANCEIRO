rules_version = '2';

// Regras de seguranca do Firestore.
//
// Conferido com o console em 05/10/2026 contra a versao publicada em
// 07/10/2025: este arquivo reproduz exatamente as regras em producao.
// A estrutura e mantida identica de proposito, para que comparar o console com o
// repositorio seja uma leitura direta, sem precisar raciocinar sobre equivalencia.
//
// Estrutura protegida (todos os dados ficam sob o usuario dono):
//   users/{uid}/caixas/{id}
//   users/{uid}/cofrinhos/{id}
//   users/{uid}/categorias/{id}
//   users/{uid}/creditCards/{id}
//   users/{uid}/creditCardPurchases/{id}
//   users/{uid}/transacoes/{periodo}/itens/{id}
//   users/{uid}/gastosFixos/{periodo}/itens/{id}
//   users/{uid}/dividas/{periodo}/itens/{id}
//   users/{uid}/receitasPrevistas/{periodo}/receitas/{id}
//
// Nao ha regra de catch-all negando o resto: no Firestore o padrao ja e negar
// quando nenhuma regra concede acesso, e um "allow: if false" nao revoga o que
// outro bloco concedeu. Qualquer caminho fora de users/{uid} fica inacessivel.

service cloud.firestore {
  match /databases/{database}/documents {
    // O documento do proprio usuario.
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Tudo abaixo dele, em qualquer profundidade.
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
