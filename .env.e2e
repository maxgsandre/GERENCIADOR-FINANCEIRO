# Ambiente dos testes end-to-end: aponta para o emulador local.
# Sem segredos -- o prefixo demo- faz o emulador rodar offline, sem projeto real.
# Vite carrega .env.[mode] depois de .env.local, entao estes valores vencem.
VITE_USE_FIREBASE_EMULATOR=true
VITE_FIREBASE_PROJECT_ID=demo-gerenciador-financeiro
VITE_FIREBASE_API_KEY=emulador
VITE_FIREBASE_AUTH_DOMAIN=demo-gerenciador-financeiro.firebaseapp.com
VITE_FIREBASE_STORAGE_BUCKET=demo-gerenciador-financeiro.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000
